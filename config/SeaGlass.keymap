#include <layout_shift.dtsi>

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#include <layout_shift_kp_override.dtsi>

#define MOUSE 4
#define SCROLL 5
#define NUM 6
#define ZMK_POINTING_DEFAULT_SCRL_VAL 120

&mt {
    flavor = "balanced";
    tapping-term-ms = <220>;
    quick-tap-ms = <175>;
    require-prior-idle-ms = <125>;
    hold-trigger-on-release;
};

&lt {
    flavor = "tap-preferred";
    tapping-term-ms = <160>;
    quick-tap-ms = <175>;
};

/ {
    combos {
        compatible = "zmk,combos";

        middle-click {
            bindings = <&mkp MB3>;
            key-positions = <40 41>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <10 11>;
        };

        backspace {
            bindings = <&kp P>;
            key-positions = <8 9>;
        };

        grave {
            bindings = <&kp GRAVE>;
            key-positions = <0 1>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        kakko: kakko {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_PARENTHESIS &kp RIGHT_PARENTHESIS &kp LEFT_ARROW>;
            label = "KAKKO";
        };

        dai_kakkko: daikakkko {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACKET &kp RIGHT_BRACKET &kp LEFT_ARROW>;
            label = "DAIKAKKKO";
        };

        nami_kakko: nami_kakko {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACE &kp RIGHT_BRACE &kp LEFT_ARROW>;
            label = "NAMI_KAKKO";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        encoder_msc_down_up: encoder_msc_down_up {
            compatible = "zmk,behavior-sensor-rotate";
            label = "ENCODER_MSC_DOWN_UP";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <20>;
        };

        encoder_msc_left_right: encoder_msc_left_right {
            compatible = "zmk,behavior-sensor-rotate";
            label = "ENCODER_MSC_LEFT_RIGHT";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&mt GRAVE Q                &kp W             &kp E             &kp R      &kp T        &kp Y        &mt LEFT_BRACKET U          &mt MINUS I          &mt EQUAL O         &kp BACKSPACE
&mt SINGLE_QUOTE A         &kp S             &kp D             &kp F      &kp G        &kp H        &lt 7 J                     &mt RIGHT_BRACKET K  &mt BACKSLASH L     &mt SEMICOLON ENTER
&mt LEFT_SHIFT Z           &kp X             &kp C             &kp V      &kp B        &kp N        &kp M                       &kp COMMA            &mt INT_YEN PERIOD  &mt INTERNATIONAL_1 SLASH
&mt LEFT_SHIFT LEFT_SHIFT  &mt LEFT_WIN TAB  &mt LEFT_ALT TAB  &kp LCTRL  &lt 2 SPACE  &lt 1 SPACE  &mt RIGHT_SHIFT LANGUAGE_5  &lt 6 LANG1          &kp ESCAPE          &mt LEFT_SHIFT DELETE
&mkp MB1                   &mkp MB2
            >;

            sensor-bindings = <&encoder_msc_down_up>, <&encoder_msc_left_right>;
        };

        SYMBOL {
            bindings = <
&kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4     &kp NUMBER_5  &kp NUMBER_6    &kp NUMBER_7          &kp NUMBER_8           &kp NUMBER_9  &kp NUMBER_0
&trans        &kp HASH      &kp ASTERISK  &kp PLUS         &kp EQUAL     &kp UNDERSCORE  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp SEMI      &kp NON_US_BACKSLASH
&trans        &kp TILDE     &kp MINUS     &kp EXCLAMATION  &kp QUESTION  &kp PIPE        &kp LBKT              &kp RBKT               &kp SQT       &kp DOUBLE_QUOTES
&trans        &trans        &trans        &trans           &trans        &trans          &kp COMMA             &kp PERIOD             &kp ESC       &lt 5 ENTER
&mkp MB1      &mkp MB2
            >;
        };

        NUM {
            bindings = <
&kp F1    &kp F2    &kp F3  &kp F4   &kp F5   &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp PLUS      &kp MINUS
&kp F6    &kp F7    &kp F8  &kp F9   &kp F10  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp ASTERISK  &kp SLASH
&trans    &trans    &trans  &kp F11  &kp F12  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp PERIOD    &kp BACKSLASH
&trans    &trans    &trans  &trans   &trans   &trans        &kp NUMBER_0  &kp COMMA     &trans        &trans
&mkp MB1  &mkp MB2
            >;
        };

        ARROW {
            bindings = <
&trans                      &mkp MB4                &kp LG(LA(UP_ARROW))  &mkp MB5                 &trans                       &kp LG(LEFT_ARROW)  &kp LA(LEFT_ARROW)  &kp UP_ARROW    &kp RA(RIGHT_ARROW)  &kp RG(RIGHT_ARROW)
&kp LA(LG(LC(LEFT_ARROW)))  &kp LA(LG(LEFT_ARROW))  &kp LA(LG(F))         &kp RG(RA(RIGHT_ARROW))  &kp RA(RC(RG(RIGHT_ARROW)))  &kp LC(LS(TAB))     &kp LEFT_ARROW      &kp DOWN_ARROW  &kp RIGHT_ARROW      &kp RC(TAB)
&trans                      &kp LG(LS(LEFT_ARROW))  &kp LG(LA(DOWN))      &kp LG(LS(RIGHT_ARROW))  &trans                       &trans              &trans              &trans          &trans               &trans
&trans                      &trans                  &trans                &trans                   &trans                       &trans              &trans              &kp BACKSPACE   &trans               &trans
&mkp MB1                    &mkp MB2
            >;

            sensor-bindings =
                <&inc_dec_kp UP_ARROW DOWN_ARROW>,
                <&inc_dec_kp RIGHT_ARROW LEFT_ARROW>;
        };

        MOUSE {
            bindings = <
&trans    &trans    &trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans
&trans    &trans    &trans  &trans  &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans    &trans    &trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans
&trans    &trans    &trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans
&mkp MB1  &mkp MB2
            >;
        };

        SHORTCUT {
            bindings = <
&trans    &trans    &kp ENTER  &trans          &trans          &trans              &trans            &trans  &trans  &trans
&trans    &trans    &kp ENTER  &trans          &trans          &trans              &trans            &trans  &trans  &trans
&trans    &trans    &trans     &trans          &trans          &trans              &trans            &trans  &trans  &trans
&trans    &trans    &trans     &kp LS(LG(N5))  &kp LS(LG(N4))  &kp LC(DOWN_ARROW)  &kp LC(UP_ARROW)  &trans  &trans  &trans
&mkp MB1  &mkp MB2
            >;
        };

        CONFIG {
            bindings = <
&bt BT_CLR_ALL  &bt BT_CLR    &trans        &trans        &trans        &trans       &trans  &trans  &tog_ls_on  &tog_ls_off
&trans          &trans        &trans        &trans        &trans        &trans       &trans  &trans  &trans      &trans
&trans          &trans        &trans        &trans        &trans        &trans       &trans  &trans  &trans      &trans
&bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bootloader  &trans  &trans  &trans      &trans
&kp LANG2       &kp LANG1
            >;
        };

        SCROLL {
            bindings = <
&kp BACKSPACE  &kp HOME  &kp UP_ARROW  &kp END    &kp DELETE  &trans  &trans  &trans  &trans  &trans
&trans         &kp LEFT  &kp DOWN      &kp RIGHT  &kp ENTER   &trans  &trans  &trans  &trans  &trans
&trans         &trans    &trans        &trans     &trans      &trans  &trans  &trans  &trans  &trans
&trans         &trans    &trans        &trans     &trans      &trans  &trans  &trans  &trans  &trans
&trans         &trans
            >;
        };

        layer_8 {
            bindings = <
&trans    &kp UP_ARROW    &trans           &trans  &trans  &trans  &trans  &trans  &trans  &kp BACKSPACE
&kp LEFT  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans  &trans  &trans  &trans  &trans  &trans  &kp ENTER
&trans    &trans          &trans           &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans    &trans          &trans           &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans    &trans
            >;
        };
    };
};
